DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hello@example.com
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
# Defaults to the SMTP host with "smtp." changed to "imap." when omitted.
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
# Optional override if your provider does not advertise its Sent folder.
EMAIL_SENT_FOLDER=
NOTIFICATION_BACKUP_EMAIL=owner@example.com

# Restrict this key to the Avonmoor domains and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=replace-with-a-restricted-browser-key
